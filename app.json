{
  "expo": {
    "name": "ZFarm Executor",
    "slug": "zfarm",
    "version": "1.0.12",
    "orientation": "portrait",
    "icon": "./assets/brand/ios/AppIcon-light-1024.png",
    "scheme": "zfarm",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/brand/android/adaptive-png/foreground-light-432.png",
        "monochromeImage": "./assets/brand/android/adaptive-png/foreground-light-432.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.zerod.fms",
      "versionCode": 13,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/android/res/mipmap-mdpi/ic_launcher.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "./plugins/with-splash-branding",
        {
          "resDir": "./assets/brand/android/res"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/brand/ios/splash/SplashLogo-light@3x.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/brand/ios/splash/SplashLogo-dark@3x.png"
          },
          "android": {
            "drawable": {
              "icon": "./assets/brand/android/res/drawable/splash_icon.xml",
              "darkIcon": "./assets/brand/android/res/drawable-night/splash_icon.xml"
            }
          }
        }
      ],
      "expo-sqlite",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "ZFarm Executor uses the camera to scan the QR code on a stock unit and link it to the delivery it arrived on.",
          "recordAudioAndroid": false
        }
      ],
      "expo-audio",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# ML Kit builds its *Registrar classes by reflection; R8 strips their no-arg constructors and the barcode scanner never registers.\n-keep class com.google.mlkit.**.*Registrar { <init>(); }",
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "icon": {
        "light": "./assets/brand/ios/AppIcon-light-1024.png",
        "dark": "./assets/brand/ios/AppIcon-dark-1024.png",
        "tinted": "./assets/brand/ios/AppIcon-tinted-1024.png"
      }
    }
  }
}
